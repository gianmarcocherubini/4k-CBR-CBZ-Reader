{
  "name": "4k-cbr-cbz-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lettore CBZ/CBR per iPad (PWA, manga-first, alta risoluzione)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "node scripts/fetch-models.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && vite build"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.15.0",
    "anime4k-webgpu": "^1.0.0",
    "idb": "^8.0.3",
    "node-unrar-js": "^2.0.2",
    "onnxruntime-web": "1.30",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.72",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
